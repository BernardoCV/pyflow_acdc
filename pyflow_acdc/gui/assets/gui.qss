/* SCADA-inspired palette (aligned with dashboard.css) */
QMainWindow {
    background-color: #f4f6f9;
    color: #111111;
}

QWidget {
    color: #111111;
}

QLabel {
    color: #111111;
}

QCheckBox {
    color: #111111;
}

QTabWidget::pane {
    border: 1px solid #c5cdd8;
    background: #ffffff;
}

QTabBar::tab {
    background: #e8ecf2;
    color: #1a2744;
    padding: 8px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #000080;
    color: #ffffff;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #c5cdd8;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
    color: #111111;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #000080;
}

QPushButton {
    background-color: #000080;
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #1a3d9e;
}

QPushButton:disabled {
    background-color: #9aa5b8;
    color: #ffffff;
}

QComboBox {
    background-color: #ffffff;
    color: #111111;
    border: 1px solid #c5cdd8;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
}

QComboBox:disabled {
    background-color: #e8ecf2;
    color: #5a6578;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #111111;
    selection-background-color: #c8d6f0;
    selection-color: #111111;
    border: 1px solid #c5cdd8;
    outline: 0;
}

QListWidget {
    border: 1px solid #c5cdd8;
    background: #ffffff;
    color: #111111;
}

QListWidget::item:selected {
    background-color: #c8d6f0;
    color: #111111;
}

QTableView {
    border: 1px solid #c5cdd8;
    gridline-color: #e8ecf2;
    background-color: #ffffff;
    color: #111111;
    alternate-background-color: #f7f8fb;
    selection-background-color: #c8d6f0;
    selection-color: #111111;
}

QHeaderView::section {
    background-color: #3a3f4b;
    color: #ffffff;
    padding: 4px 6px;
    border: 1px solid #2c3038;
    font-weight: bold;
}

QTextEdit {
    border: 1px solid #c5cdd8;
    background-color: #ffffff;
    color: #111111;
    font-family: Consolas, "Courier New", monospace;
    font-size: 11px;
    selection-background-color: #c8d6f0;
    selection-color: #111111;
}

QMessageBox {
    background-color: #ffffff;
    color: #111111;
}

QMessageBox QLabel {
    color: #111111;
    background-color: transparent;
}

QMessageBox QPushButton {
    background-color: #000080;
    color: #ffffff;
    min-width: 72px;
}

QStatusBar {
    background: #e8ecf2;
    color: #1a2744;
}

#gridSidebar {
    background-color: #eef1f6;
    border-right: 1px solid #c5cdd8;
}

#sidebarLogo {
    background: transparent;
}

#sidebarToggle {
    background-color: #000080;
    color: #ffffff;
    padding: 6px 10px;
}
